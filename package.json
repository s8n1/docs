{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "description": "Mintlify documentation site (Mintlify Starter Kit)",
  "scripts": {
    "dev": "mintlify dev --no-open --port ${PORT:-3000}",
    "preview": "mintlify dev --no-open --port ${PORT:-3000}",
    "build": "mintlify export",
    "start": "sh scripts/serve.sh",
    "api": "sh scripts/serve.sh",
    "setup": "sh scripts/setup.sh",
    "solve": "python3 -m api.cli",
    "test:solver": "python3 -m pytest api/test_solver_core.py",
    "test:all": "python3 -m pytest api/ -q"
  },
  "devDependencies": {
    "mintlify": "^4.2.788"
  }
}
